34;&#3627;&#3660;&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value=&quot;1.55&quot;&gt;&#3629;&#3629;&#3585;&#3585;&#3635;&#3621;&#3633;&#3591;&#3585;&#3634;&#3618;&#3611;&#3634;&#3609;&#3585;&#3621;&#3634;&#3591; 3-5 &#3623;&#3633;&#3609;/&#3626;&#3633;&#3611;&#3604;&#3634;&#3627;&#3660;&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value=&quot;1.725&quot;&gt;&#3629;&#3629;&#3585;&#3585;&#3635;&#3621;&#3633;&#3591;&#3585;&#3634;&#3618;&#3627;&#3609;&#3633;&#3585; 6-7 &#3623;&#3633;&#3609;/&#3626;&#3633;&#3611;&#3604;&#3634;&#3627;&#3660;&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/select&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label class=&quot;block text-slate-600 mb-1&quot;&gt;&#3648;&#3611;&#3657;&#3634;&#3627;&#3617;&#3634;&#3618;&#3626;&#3640;&#3586;&#3616;&#3634;&#3614;&lt;/label&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;select id=&quot;goal&quot; class=&quot;w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 outline-none focus:border-emerald-500&quot;&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value=&quot;maintain&quot;&gt;&#3619;&#3633;&#3585;&#3625;&#3634;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585;&#3605;&#3633;&#3623;&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value=&quot;lose&quot;&gt;&#3621;&#3604;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585; (-500 kcal/&#3623;&#3633;&#3609;)&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value=&quot;gain&quot;&gt;&#3648;&#3614;&#3636;&#3656;&#3617;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585; (+500 kcal/&#3623;&#3633;&#3609;)&lt;/option&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/select&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;button type=&quot;submit&quot; class=&quot;w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl shadow-md transition mt-2&quot;&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &#3610;&#3633;&#3609;&#3607;&#3638;&#3585;&#3586;&#3657;&#3629;&#3617;&#3641;&#3621;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/button&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/form&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;/div&gt;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;!-- Notification Toast --&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;div id=&quot;toast&quot; class=&quot;fixed top-16 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-4 py-2 rounded-full text-xs shadow-lg transition-all duration-300 opacity-0 pointer-events-none z-50 flex items-center gap-2&quot;&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &lt;i class=&quot;fa-solid fa-circle-check text-emerald-400&quot;&gt;&lt;/i&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &lt;span id=&quot;toastMsg&quot;&gt;&#3610;&#3633;&#3609;&#3607;&#3638;&#3585;&#3586;&#3657;&#3629;&#3617;&#3641;&#3621;&#3648;&#3619;&#3637;&#3618;&#3610;&#3619;&#3657;&#3629;&#3618;&#3649;&#3621;&#3657;&#3623;&lt;/span&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;/div&gt;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;!-- MAIN JAVASCRIPT LOGIC --&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &lt;script&gt;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // API KEY SETUP</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; const apiKey = &quot;&quot;; // Runtime key placeholder</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // APP STATE</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let userProfile = {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; gender: &#39;male&#39;,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; age: 18,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; height: 165,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; weight: 60,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; activity: 1.375,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; goal: &#39;maintain&#39;,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bmr: 1500,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; tdee: 2000</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; };</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let dailyLogs = [];</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let waterIntake = 0;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let activeStream = null;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let currentFacingMode = &#39;environment&#39;; // &#39;user&#39; or &#39;environment&#39;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; let currentAnalyzedFood = null;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // FOOD DATABASE PRESETS</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; const foodDatabase = [</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3586;&#3657;&#3634;&#3623;&#3617;&#3633;&#3609;&#3652;&#3585;&#3656;&quot;, cal: 596, p: 24, c: 68, f: 22, desc: &quot;&#3586;&#3657;&#3634;&#3623;&#3627;&#3640;&#3591;&#3609;&#3657;&#3635;&#3617;&#3633;&#3609;&#3652;&#3585;&#3656; &#3648;&#3626;&#3636;&#3619;&#3660;&#3615;&#3614;&#3619;&#3657;&#3629;&#3617;&#3648;&#3609;&#3639;&#3657;&#3629;&#3652;&#3585;&#3656;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3586;&#3657;&#3634;&#3623;&#3612;&#3633;&#3604;&#3585;&#3632;&#3648;&#3614;&#3619;&#3634;&#3652;&#3586;&#3656;&#3604;&#3634;&#3623;&quot;, cal: 630, p: 28, c: 65, f: 26, desc: &quot;&#3585;&#3632;&#3648;&#3614;&#3619;&#3634;&#3627;&#3617;&#3641;&#3626;&#3633;&#3610;&#3614;&#3619;&#3657;&#3629;&#3617;&#3652;&#3586;&#3656;&#3604;&#3634;&#3623;&#3607;&#3629;&#3604;&#3585;&#3619;&#3629;&#3610;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3626;&#3657;&#3617;&#3605;&#3635;&#3652;&#3607;&#3618;&quot;, cal: 120, p: 4, c: 24, f: 1, desc: &quot;&#3626;&#3657;&#3617;&#3605;&#3635;&#3619;&#3626;&#3648;&#3611;&#3619;&#3637;&#3657;&#3618;&#3623;&#3627;&#3623;&#3634;&#3609; &#3617;&#3632;&#3621;&#3632;&#3585;&#3629;&#3626;&#3604; &#3606;&#3633;&#3656;&#3623;&#3614;&#3621;&#3632;&#3585;&#3640;&#3657;&#3591;&#3649;&#3627;&#3657;&#3591;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3585;&#3659;&#3623;&#3618;&#3648;&#3605;&#3637;&#3659;&#3618;&#3623;&#3648;&#3619;&#3639;&#3629;&#3627;&#3617;&#3641;&#3609;&#3657;&#3635;&#3605;&#3585;&quot;, cal: 380, p: 20, c: 42, f: 12, desc: &quot;&#3648;&#3626;&#3657;&#3609;&#3585;&#3659;&#3623;&#3618;&#3648;&#3605;&#3637;&#3659;&#3618;&#3623;&#3595;&#3640;&#3611;&#3609;&#3657;&#3635;&#3605;&#3585;&#3627;&#3617;&#3641;&#3626;&#3604;&#3621;&#3641;&#3585;&#3594;&#3636;&#3657;&#3609;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3586;&#3657;&#3634;&#3623;&#3652;&#3586;&#3656;&#3648;&#3592;&#3637;&#3618;&#3623;&quot;, cal: 440, p: 12, c: 45, f: 24, desc: &quot;&#3652;&#3586;&#3656;&#3648;&#3592;&#3637;&#3618;&#3623;&#3615;&#3641;&#3609;&#3640;&#3656;&#3617;&#3607;&#3634;&#3609;&#3588;&#3641;&#3656;&#3585;&#3633;&#3610;&#3586;&#3657;&#3634;&#3623;&#3626;&#3623;&#3618;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3612;&#3633;&#3604;&#3652;&#3607;&#3618;&#3585;&#3640;&#3657;&#3591;&#3626;&#3604;&quot;, cal: 580, p: 22, c: 62, f: 24, desc: &quot;&#3648;&#3626;&#3657;&#3609;&#3592;&#3633;&#3609;&#3607;&#3660;&#3612;&#3633;&#3604;&#3595;&#3629;&#3626;&#3612;&#3633;&#3604;&#3652;&#3607;&#3618; &#3585;&#3640;&#3657;&#3591;&#3626;&#3604; &#3649;&#3621;&#3632;&#3606;&#3633;&#3656;&#3623;&#3614;&#3641;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3605;&#3657;&#3617;&#3618;&#3635;&#3585;&#3640;&#3657;&#3591;&#3609;&#3657;&#3635;&#3586;&#3657;&#3609;&quot;, cal: 320, p: 18, c: 14, f: 20, desc: &quot;&#3605;&#3657;&#3617;&#3618;&#3635;&#3619;&#3626;&#3649;&#3595;&#3656;&#3610;&#3626;&#3617;&#3640;&#3609;&#3652;&#3614;&#3619;&#3652;&#3607;&#3618; &#3651;&#3626;&#3656;&#3585;&#3640;&#3657;&#3591;&#3649;&#3621;&#3632;&#3609;&#3617;&#3626;&#3604;&quot; },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { name: &quot;&#3649;&#3585;&#3591;&#3648;&#3586;&#3637;&#3618;&#3623;&#3627;&#3623;&#3634;&#3609;&#3652;&#3585;&#3656;&quot;, cal: 480, p: 20, c: 12, f: 38, desc: &quot;&#3649;&#3585;&#3591;&#3585;&#3632;&#3607;&#3636;&#3648;&#3586;&#3637;&#3618;&#3623;&#3627;&#3623;&#3634;&#3609;&#3652;&#3585;&#3656;&#3651;&#3626;&#3656;&#3618;&#3629;&#3604;&#3617;&#3632;&#3614;&#3619;&#3657;&#3634;&#3623;&quot; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; ];</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // INITIALIZATION</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; window.addEventListener(&#39;DOMContentLoaded&#39;, () =&gt; {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; loadUserProfile();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; calculateHealthMetrics();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; updateDashboardUI();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; renderFoodDatabase(foodDatabase);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; initChart();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; });</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // NAVIGATION TABS</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function switchTab(tabId) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; [&#39;dashboard&#39;, &#39;camera&#39;, &#39;search&#39;, &#39;stats&#39;].forEach(id =&gt; {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const el = document.getElementById(`tab-${id}`);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const nav = document.getElementById(`nav-${id}`);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (id === tabId) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; el.classList.remove(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; nav.classList.add(&#39;text-emerald-600&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; nav.classList.remove(&#39;text-slate-400&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; el.classList.add(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; nav.classList.remove(&#39;text-emerald-600&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; nav.classList.add(&#39;text-slate-400&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; });</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (tabId === &#39;camera&#39;) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; startCamera();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; stopCamera();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (tabId === &#39;stats&#39;) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; updateChart();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // HEALTH METRICS CALCULATOR (BMR &amp; TDEE &amp; BMI)</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function calculateHealthMetrics() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const { gender, age, height, weight, activity, goal } = userProfile;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // BMR using Mifflin-St Jeor Equation</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let bmr = (10 * weight) + (6.25 * height) - (5 * age);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (gender === &#39;male&#39;) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bmr += 5;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bmr -= 161;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; userProfile.bmr = Math.round(bmr);</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // TDEE</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let tdee = Math.round(bmr * parseFloat(activity));</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (goal === &#39;lose&#39;) tdee -= 500;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (goal === &#39;gain&#39;) tdee += 500;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; userProfile.tdee = Math.max(1200, tdee); // Min safety threshold</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // BMI</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const heightM = height / 100;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; userProfile.bmi = (weight / (heightM * heightM)).toFixed(1);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function updateDashboardUI() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashTDEE&#39;).innerText = userProfile.tdee.toLocaleString();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashBMI&#39;).innerText = `BMI: ${userProfile.bmi}`;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Calculate Eaten Totals</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const eatenCal = dailyLogs.reduce((sum, item) =&gt; sum + item.cal, 0);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const eatenP = dailyLogs.reduce((sum, item) =&gt; sum + item.p, 0);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const eatenC = dailyLogs.reduce((sum, item) =&gt; sum + item.c, 0);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const eatenF = dailyLogs.reduce((sum, item) =&gt; sum + item.f, 0);</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const remaining = Math.max(0, userProfile.tdee - eatenCal);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const percent = Math.min(100, Math.round((eatenCal / userProfile.tdee) * 100));</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashEaten&#39;).innerText = eatenCal.toLocaleString();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashRemaining&#39;).innerText = remaining.toLocaleString();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashProgressBar&#39;).style.width = `${percent}%`;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashProtein&#39;).innerText = `${eatenP}g`;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashCarbs&#39;).innerText = `${eatenC}g`;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;dashFat&#39;).innerText = `${eatenF}g`;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; renderTodayLogs();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; updateStatsTabUI();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function updateStatsTabUI() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;statBMR&#39;).innerText = `${userProfile.bmr.toLocaleString()} kcal`;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;statTDEE&#39;).innerText = `${userProfile.tdee.toLocaleString()} kcal`;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;statBMIVal&#39;).innerText = userProfile.bmi;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const bmi = parseFloat(userProfile.bmi);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let label = &quot;&#3626;&#3617;&#3626;&#3656;&#3623;&#3609;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let desc = &quot;&#3588;&#3640;&#3603;&#3617;&#3637;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585;&#3629;&#3618;&#3641;&#3656;&#3651;&#3609;&#3648;&#3585;&#3603;&#3601;&#3660;&#3611;&#3585;&#3605;&#3636;&quot;;</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (bmi &lt; 18.5) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; label = &quot;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585;&#3609;&#3657;&#3629;&#3618; / &#3612;&#3629;&#3617;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; desc = &quot;&#3588;&#3623;&#3619;&#3619;&#3633;&#3610;&#3611;&#3619;&#3632;&#3607;&#3634;&#3609;&#3629;&#3634;&#3627;&#3634;&#3619;&#3607;&#3637;&#3656;&#3617;&#3637;&#3588;&#3640;&#3603;&#3588;&#3656;&#3634;&#3607;&#3634;&#3591;&#3650;&#3616;&#3594;&#3609;&#3634;&#3585;&#3634;&#3619;&#3648;&#3614;&#3636;&#3656;&#3617;&#3586;&#3638;&#3657;&#3609;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else if (bmi &gt;= 23 &amp;&amp; bmi &lt; 25) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; label = &quot;&#3609;&#3657;&#3635;&#3627;&#3609;&#3633;&#3585;&#3648;&#3585;&#3636;&#3609;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; desc = &quot;&#3648;&#3619;&#3636;&#3656;&#3617;&#3617;&#3637;&#3588;&#3623;&#3634;&#3617;&#3648;&#3626;&#3637;&#3656;&#3618;&#3591; &#3588;&#3623;&#3619;&#3588;&#3623;&#3610;&#3588;&#3640;&#3617;&#3629;&#3634;&#3627;&#3634;&#3619;&#3649;&#3621;&#3632;&#3629;&#3629;&#3585;&#3585;&#3635;&#3621;&#3633;&#3591;&#3585;&#3634;&#3618;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else if (bmi &gt;= 25) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; label = &quot;&#3650;&#3619;&#3588;&#3629;&#3657;&#3623;&#3609;&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; desc = &quot;&#3588;&#3623;&#3619;&#3611;&#3619;&#3633;&#3610;&#3614;&#3620;&#3605;&#3636;&#3585;&#3619;&#3619;&#3617;&#3585;&#3634;&#3619;&#3610;&#3619;&#3636;&#3650;&#3616;&#3588;&#3629;&#3634;&#3627;&#3634;&#3619;&#3648;&#3614;&#3639;&#3656;&#3629;&#3621;&#3604;&#3588;&#3623;&#3634;&#3617;&#3648;&#3626;&#3637;&#3656;&#3618;&#3591; NCDs&quot;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;statBMILabel&#39;).innerText = `BMI: ${bmi} (${label})`;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;statBMIDesc&#39;).innerText = desc;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // CAMERA HANDLING &amp; PERMISSIONS</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; async function startCamera() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const video = document.getElementById(&#39;webcam&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const offlinePlaceholder = document.getElementById(&#39;cameraOffline&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const captureBtn = document.getElementById(&#39;captureBtn&#39;);</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; stopCamera(); // Stop existing stream if any</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; try {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const constraints = {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; video: {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; facingMode: currentFacingMode,</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; width: { ideal: 1280 },</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; height: { ideal: 720 }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; };</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; activeStream = await navigator.mediaDevices.getUserMedia(constraints);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; video.srcObject = activeStream;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; video.classList.remove(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; offlinePlaceholder.classList.add(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; captureBtn.disabled = false;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } catch (err) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; console.error(&quot;Camera access error:&quot;, err);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; offlinePlaceholder.classList.remove(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; video.classList.add(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; captureBtn.disabled = true;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; showToast(&quot;&#3652;&#3617;&#3656;&#3626;&#3634;&#3617;&#3634;&#3619;&#3606;&#3648;&#3586;&#3657;&#3634;&#3606;&#3638;&#3591;&#3585;&#3621;&#3657;&#3629;&#3591;&#3652;&#3604;&#3657; &#3585;&#3619;&#3640;&#3603;&#3634;&#3629;&#3609;&#3640;&#3597;&#3634;&#3605;&#3585;&#3634;&#3619;&#3626;&#3636;&#3607;&#3608;&#3636;&#3660;&#3651;&#3594;&#3657;&#3585;&#3621;&#3657;&#3629;&#3591;&quot;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function stopCamera() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (activeStream) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; activeStream.getTracks().forEach(track =&gt; track.stop());</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; activeStream = null;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function switchCameraFacing() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; currentFacingMode = currentFacingMode === &#39;environment&#39; ? &#39;user&#39; : &#39;environment&#39;;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; startCamera();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function triggerFileInput() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; document.getElementById(&#39;fileInput&#39;).click();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; function handleFileSelect(event) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const file = event.target.files[0];</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (file) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const reader = new FileReader();</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; reader.onload = function(e) {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const preview = document.getElementById(&#39;capturedImagePreview&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; preview.src = e.target.result;</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; preview.classList.remove(&#39;hidden&#39;);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; analyzeImageWithGemini(e.target.result.split(&#39;,&#39;)[1]);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; };</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; reader.readAsDataURL(file);</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p class="c1 c2"><span class="c0"></span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; // CAPTURE &amp; GEMINI VISION API CALL</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; async function captureAndAnalyze() {</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; 